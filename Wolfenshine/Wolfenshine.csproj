<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Version>0.1</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Wolfenshine</AssemblyName>
    <RootNamespace>Wolfenshine</RootNamespace>
    <ApplicationIcon>Assets/Wolfenshine.ico</ApplicationIcon>
    <Authors>Dean Edis</Authors>
    <Company>Dean Edis (DeanTheCoder)</Company>
    <Copyright>Copyright (c) 2026 Dean Edis</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="NukedOPL3Sharp" Version="1.2.1" />
    <PackageReference Include="OpenTK.Audio.OpenAL" Version="4.8.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DTC.Core/DTC.Core/DTC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <LocalWolfensteinData Include="$(MSBuildProjectDirectory)/../local/game-data/*.WL6" />
    <LocalWolfensteinPalette Include="$(MSBuildProjectDirectory)/../local/game-data/GAMEPAL.OBJ"
                             Condition="Exists('$(MSBuildProjectDirectory)/../local/game-data/GAMEPAL.OBJ')" />
  </ItemGroup>

  <Target Name="CopyLocalWolfensteinData" AfterTargets="Build" Condition="'@(LocalWolfensteinData)' != ''">
    <MakeDir Directories="$(TargetDir)GameData" />
    <Copy SourceFiles="@(LocalWolfensteinData)"
          DestinationFolder="$(TargetDir)GameData"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LocalWolfensteinPalette)"
          DestinationFolder="$(TargetDir)GameData"
          SkipUnchangedFiles="true"
          Condition="'@(LocalWolfensteinPalette)' != ''" />
  </Target>
</Project>
