// Wolfenshine's enhanced renderer keeps map traversal on the CPU and sends one
// compact raycast result for each of the 320 native screen columns. This shader
// projects and textures those walls, applies distance illumination, and finally
// composites the software-rendered sprites and HUD. Sprites deliberately remain
// outside the wall-lighting calculation until they receive their own depth data.

uniform float2 outputResolution; // Actual control size; normally 320 x 240 after 4:3 correction.
uniform float viewBob;            // Vertical camera displacement in native 320 x 200 pixels.
uniform float damageFlash;        // 0..1 red flash applied to the completed frame.
uniform float deathFade;          // 0..1 dithered red replacement applied to the play view.
uniform float levelFade;          // 0..1 black fade applied to the completed frame.
uniform float4 ceilingColor;      // Original palette color for the current level's ceiling.
uniform float4 floorColor;        // Original palette color for the floor.
uniform float4 deathColor;        // Original palette red used by the death transition.

// One packed float4 describes each raycast column without color-space conversion:
//   X = perpendicular distance; also the future wall depth
//   Y = horizontal texture coordinate, 0..1
//   Z = resolved VSWAP texture-page index
//   W = packed wall flags: bit 0 horizontal orientation, bit 1 concave
//       corner at texture U=0, bit 2 concave corner at texture U=1
uniform float4 wallColumns[320];

// The thirty-two nearest light-emitting map objects:
//   X/Y = position in map tiles
//   Z = upward brightness
//   W = downward brightness
// Unused records have zero brightness. Encoding emitted light rather than an
// object type lets future map objects participate without changing this shader.
uniform float4 sceneLights[32];
uniform float2 sceneLightRadii[32]; // Upward and downward radius in map tiles.
uniform float2 playerPosition;
uniform float2 cameraDirection;
uniform float2 cameraPlane;
uniform float muzzleFlash; // Brief 0..1 player weapon flash.
uniform float dungeonDarkness; // Smooth 0..1 proximity to a blue-stone jail area.

// A 64-pixel-wide atlas containing every decoded VSWAP wall page. Each page is
// 64 x 64 and pages are stacked vertically. CPU palette lookup currently makes
// this an RGBA atlas; a future version can instead send indices plus a palette.
uniform shader wallTextureAtlas;

// A transparent 320 x 200 image containing world sprites, enemies, and the HUD.
// Software projection is retained for now, then composited after wall light
// so an enemy is not accidentally shaded using the wall behind it.
uniform shader softwareSpriteOverlay;

// The weapon is separate so nearby downward light can illuminate it without
// changing the brightness of enemies or the fixed HUD.
uniform shader softwareWeaponOverlay;

float randomHash(float2 position)
{
    return fract(sin(dot(position, float2(12.9898, 78.233))) * 43758.5453);
}

float distanceIllumination(float distance)
{
    return max(0.20, 1.0 / (1.0 + distance * 0.22));
}

float ambientIllumination(float distance)
{
    return distanceIllumination(distance) * mix(1.0, 0.55, dungeonDarkness);
}

float smoothRamp(float value)
{
    value = clamp(value, 0.0, 1.0);
    return value * value * (3.0 - (2.0 * value));
}

float wallAmbientOcclusion(float textureU, float textureV, float packedFlags)
{
    // Wolfenstein's one-tile-high walls have no geometric bevels or lightmap,
    // so shade their floor/ceiling boundaries and only those horizontal ends
    // where map geometry identifies a genuine inward corner.
    float textureStartCorner = floor(packedFlags / 2.0) - (floor(packedFlags / 4.0) * 2.0);
    float textureEndCorner = floor(packedFlags / 4.0);
    float verticalDistance = min(textureV, 1.0 - textureV);
    float textureStartEdge = (1.0 - smoothRamp(textureU / 0.11)) * textureStartCorner;
    float textureEndEdge = (1.0 - smoothRamp((1.0 - textureU) / 0.11)) * textureEndCorner;
    float verticalEdge = smoothRamp(verticalDistance / 0.10);
    // Stronger shading at a true inward join makes the otherwise paper-thin grid geometry read as a solid corner.
    float occlusion = ((textureStartEdge + textureEndEdge) * 0.60) +
                      ((1.0 - verticalEdge) * 0.093);
    return 1.0 - min(occlusion, 0.65);
}

float surfaceContactAmbientOcclusion(float pixelDistance, float projectedWallHeight)
{
    // Extend the wall contact shadow onto the adjoining flat surface. Scale its
    // screen-space width with the projected wall so it remains visible nearby
    // without swallowing distant floor and ceiling pixels.
    float radius = clamp(projectedWallHeight * 0.08, 2.0, 8.0);
    float edge = smoothRamp(pixelDistance / radius);
    return mix(0.86, 1.0, edge);
}

float weaponIllumination()
{
    // The weapon starts darker than its original palette values. Downward
    // brightness raises it toward full brightness beneath ceiling light cones.
    float illumination = 0.60 * mix(1.0, 0.55, dungeonDarkness);
    for (int index = 0; index < 32; index++)
    {
        float4 light = sceneLights[index];
        float distance = length(playerPosition - light.xy);
        float conePosition = clamp(distance / 1.5, 0.0, 1.0);
        float cone = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
        illumination += light.w * cone * 0.80;
    }
    illumination += muzzleFlash * 0.40;
    return clamp(illumination, 0.20, 1.0);
}

float muzzleIllumination(float2 worldPosition)
{
    const float radius = 2.50;
    float2 flashPosition = playerPosition + (cameraDirection * 0.35);
    float distance = length(worldPosition - flashPosition);
    float conePosition = clamp(distance / radius, 0.0, 1.0);
    float falloff = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
    return muzzleFlash * falloff * 0.90;
}

float surfaceIllumination(float2 worldPosition, float upward)
{
    float illumination = 0.0;
    for (int index = 0; index < 32; index++)
    {
        float4 light = sceneLights[index];
        float brightness = mix(light.w, light.z, upward);
        float2 radii = sceneLightRadii[index];
        float radius = max(mix(radii.y, radii.x, upward), 0.0001);
        float distance = length(worldPosition - light.xy);
        float conePosition = clamp(distance / radius, 0.0, 1.0);
        float cone = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
        illumination += brightness * cone * 0.65;
    }
    return illumination;
}

float4 main(float2 fragment)
{
    const float nativeWidth = 320.0;
    const float nativeHeight = 200.0;
    const float nativePlayHeight = 160.0;
    const float textureSize = 64.0;

    // Convert Avalonia's 4:3 presentation coordinates back to native Mode 13h
    // coordinates. Horizontal and vertical scale are kept separate for resizing.
    float2 displayScale = outputResolution / float2(nativeWidth, nativeHeight);
    float2 nativePosition = fragment / displayScale;
    bool isPlayView = nativePosition.y < nativePlayHeight;

    // View bob moves the 3D scene and its sprites, but never the fixed HUD.
    float2 scenePosition = nativePosition;
    if (isPlayView)
        scenePosition.y = clamp(scenePosition.y - viewBob, 0.5, nativePlayHeight - 0.5);

    int columnIndex = clamp(int(scenePosition.x), 0, 319);
    float cameraX = (2.0 * (scenePosition.x + 0.5) / nativeWidth) - 1.0;
    float2 rayDirection = cameraDirection + (cameraPlane * cameraX);
    float4 column = wallColumns[columnIndex];
    float distance = max(column.x, 0.0001);
    float projectedHeight = nativeHeight / distance;
    float wallTop = (nativePlayHeight - projectedHeight) * 0.5;

    float4 color;
    if (!isPlayView)
    {
        color = floorColor;
    }
    else if (scenePosition.y < wallTop)
    {
        color = ceilingColor;
        // Intersect the view ray with the unit-height ceiling plane. The camera
        // is halfway between floor and ceiling, giving a 100-pixel projection height.
        float ceilingDistance = 100.0 / max(80.0 - scenePosition.y, 0.5);
        float2 ceilingPosition = playerPosition + (rayDirection * ceilingDistance);
        float illumination = ambientIllumination(ceilingDistance);
        illumination += surfaceIllumination(ceilingPosition, 1.0);
        illumination += muzzleIllumination(ceilingPosition);
        color.rgb *= min(illumination, 1.0);
        color.rgb *= surfaceContactAmbientOcclusion(wallTop - scenePosition.y, projectedHeight);
    }
    else if (scenePosition.y >= wallTop + projectedHeight)
    {
        color = floorColor;
        float floorDistance = 100.0 / max(scenePosition.y - 80.0, 0.5);
        float2 floorPosition = playerPosition + (rayDirection * floorDistance);
        float illumination = ambientIllumination(floorDistance);
        illumination += surfaceIllumination(floorPosition, 0.0);
        illumination += muzzleIllumination(floorPosition);
        color.rgb *= min(illumination, 1.0);
        color.rgb *= surfaceContactAmbientOcclusion(
            scenePosition.y - (wallTop + projectedHeight),
            projectedHeight);
    }
    else
    {
        // Project the native screen row back onto the 64-pixel wall texture.
        float textureV = clamp((scenePosition.y - wallTop) / projectedHeight, 0.0, 0.999999);
        float textureX = floor(clamp(column.y, 0.0, 0.999999) * textureSize) + 0.5;
        float texturePage = floor(column.z + 0.5);
        float textureY = (texturePage * textureSize) + floor(textureV * textureSize) + 0.5;
        color = sample(wallTextureAtlas, float2(textureX, textureY));

        // Distance is perpendicular to the camera plane, so this darkening does
        // not bow across the screen and can later be combined with real lights.
        float illumination = ambientIllumination(distance);
        float orientation = column.w - (floor(column.w / 2.0) * 2.0);
        illumination *= mix(1.0, 0.92, orientation);
        float2 wallPosition = playerPosition + (rayDirection * distance);
        // Vertical walls receive a restrained blend of the upward and downward
        // components. This lets local sources such as treasure softly illuminate
        // nearby walls without overpowering their directional floor/ceiling light.
        illumination += surfaceIllumination(wallPosition, 0.5) * 0.60;
        illumination += muzzleIllumination(wallPosition);
        color.rgb *= min(illumination, 1.0);
        color.rgb *= wallAmbientOcclusion(column.y, textureV, column.w);
    }

    // World sprites follow view bob; the HUD remains fixed.
    float4 overlay = sample(softwareSpriteOverlay, isPlayView ? scenePosition : nativePosition);
    color = float4(mix(color.rgb, overlay.rgb, overlay.a), 1.0);

    // Composite the separately rendered weapon after world sprites, matching the
    // software draw order while allowing only the weapon to react to overhead light.
    float4 weapon = sample(softwareWeaponOverlay, scenePosition);
    weapon.rgb *= weaponIllumination();
    color = float4(mix(color.rgb, weapon.rgb, weapon.a), 1.0);

    // Preserve the original full-frame feedback ordering after scene composition.
    if (isPlayView && randomHash(nativePosition) < deathFade)
        color = deathColor;
    color.rgb = mix(color.rgb, float3(1.0, 0.0, 0.0), clamp(damageFlash, 0.0, 1.0));
    color.rgb *= 1.0 - clamp(levelFade, 0.0, 1.0);
    return float4(color.rgb, 1.0);
}
