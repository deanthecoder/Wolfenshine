// Wolfenshine's enhanced renderer keeps map traversal on the CPU and sends one
// compact raycast result for each of the 320 native screen columns. This shader
// projects and textures those walls, applies distance illumination, and finally
// composites the software-rendered sprites and HUD. Sprites deliberately remain
// outside the wall-lighting calculation until they receive their own depth data.

uniform float2 outputResolution; // Actual control size; normally 320 x 240 after 4:3 correction.
uniform float viewBob;            // Vertical camera displacement in native 320 x 200 pixels.
uniform float weaponSway;         // Horizontal weapon displacement in native pixels.
uniform float damageFlash;        // 0..1 red flash applied to the completed frame.
uniform float deathFade;          // 0..1 dithered red replacement applied to the play view.
uniform float levelFade;          // 0..1 black fade applied to the completed frame.
uniform float4 ceilingColor;      // Original palette color for the current level's ceiling.
uniform float4 floorColor;        // Original palette color for the floor.
uniform float4 deathColor;        // Original palette red used by the death transition.

// One packed float4 describes each raycast column without color-space conversion:
//   X = perpendicular distance; also the future wall depth
//   Y = horizontal texture coordinate, 0..1
//   Z = resolved VSWAP texture-page index
//   W = packed wall flags: bit 0 horizontal orientation, bit 1 concave
//       corner at texture U=0, bit 2 concave corner at texture U=1,
//       bit 3 door panel
uniform float4 wallColumns[320];

// The thirty-two nearest light-emitting map objects:
//   X/Y = position in map tiles
//   Z = upward brightness
//   W = downward brightness
// Unused records have zero brightness. Encoding emitted light rather than an
// object type lets future map objects participate without changing this shader.
uniform float4 sceneLights[32];
uniform float2 sceneLightRadii[32]; // Upward and downward radius in map tiles.
uniform float4 sceneLightUpColors[32]; // RGB tint emitted toward the ceiling.
uniform float4 sceneLightDownColors[32]; // RGB tint emitted toward the floor.
uniform float sceneLightHeights[32]; // Approximate source height within its map tile, 0..1.

// The thirty-two nearest open doors separating differently lit rooms:
//   X/Y = door center
//   Z/W = direction from the brighter room into the darker room, with vector
//         length encoding ambient contrast multiplied by the door's opening.
uniform float4 doorwaySpills[32];
uniform float2 playerPosition;
uniform float2 cameraDirection;
uniform float2 cameraPlane;
uniform float muzzleFlash; // Brief 0..1 player weapon flash.
uniform float weaponFlash; // 1 while the current weapon artwork visibly contains a muzzle flash.
uniform float playerAmbientScale; // Player ambience, smoothly blended while crossing open doors.
uniform float areaAmbientMaximum; // Decodes the normalized per-tile ambient map.
uniform float areaAmbientPixelsPerTile; // Sub-tile resolution used for smooth doorway blending.
uniform float4 fogColor; // Atmospheric RGB color; alpha is unused.
uniform float4 fogParameters; // Start distance, end distance, maximum blend, unused.

// A 64-pixel-wide atlas containing every decoded VSWAP wall page. Each page is
// 64 x 64 and pages are stacked vertically. CPU palette lookup currently makes
// this an RGBA atlas; a future version can instead send indices plus a palette.
uniform shader wallTextureAtlas;

// Generated from a softly blurred luminance version of each original wall page.
// Material values are stored separately as bump strength, specular strength,
// and gloss so wood, stone, blue brick, and metal can respond differently.
uniform shader wallHeightAtlas;
uniform shader wallMaterialMap;

// One texel per map tile stores ambience for the geometry-derived room or corridor.
// Sampling it at each surface position lets a bright room remain visible through
// a doorway without also raising the ambient light around the player.
uniform shader areaAmbientMap;

// A transparent 320 x 200 image containing world sprites, enemies, and the HUD.
// Software projection is retained for now, then composited after wall light
// so an enemy is not accidentally shaded using the wall behind it.
uniform shader softwareSpriteOverlay;

// The weapon is separate so nearby downward light can illuminate it without
// changing the brightness of enemies or the fixed HUD.
uniform shader softwareWeaponOverlay;

// Additive screen-space glow centered on luminous ceiling fixtures, chandeliers,
// and treasure. It is generated from the original sprite artwork on the CPU.
uniform shader softwareBloomOverlay;

float randomHash(float2 position)
{
    return fract(sin(dot(position, float2(12.9898, 78.233))) * 43758.5453);
}

float distanceIllumination(float distance)
{
    return max(0.20, 1.0 / (1.0 + distance * 0.22));
}

float ambientIllumination(float distance, float2 worldPosition)
{
    float ambientScale = sample(areaAmbientMap, worldPosition * areaAmbientPixelsPerTile).r *
                         areaAmbientMaximum;
    return distanceIllumination(distance) * ambientScale;
}

float smoothRamp(float value)
{
    value = clamp(value, 0.0, 1.0);
    return value * value * (3.0 - (2.0 * value));
}

float distanceFogAmount(float distance)
{
    float fogPosition = (distance - fogParameters.x) /
                        max(fogParameters.y - fogParameters.x, 0.0001);
    return smoothRamp(fogPosition) * fogParameters.z;
}

float wallAmbientOcclusion(float textureU, float textureV, float packedFlags)
{
    // Wolfenstein's one-tile-high walls have no geometric bevels or lightmap,
    // so shade their floor/ceiling boundaries and only those horizontal ends
    // where map geometry identifies a genuine inward corner.
    float textureStartCorner = floor(packedFlags / 2.0) - (floor(packedFlags / 4.0) * 2.0);
    float textureEndCorner = floor(packedFlags / 4.0) - (floor(packedFlags / 8.0) * 2.0);
    float verticalDistance = min(textureV, 1.0 - textureV);
    float textureStartEdge = (1.0 - smoothRamp(textureU / 0.11)) * textureStartCorner;
    float textureEndEdge = (1.0 - smoothRamp((1.0 - textureU) / 0.11)) * textureEndCorner;
    float verticalEdge = smoothRamp(verticalDistance / 0.10);
    // Stronger shading at a true inward join makes the otherwise paper-thin grid geometry read as a solid corner.
    float occlusion = ((textureStartEdge + textureEndEdge) * 0.60) +
                      ((1.0 - verticalEdge) * 0.093);
    return 1.0 - min(occlusion, 0.65);
}

float surfaceContactAmbientOcclusion(float pixelDistance, float projectedWallHeight)
{
    // Extend the wall contact shadow onto the adjoining flat surface. Scale its
    // screen-space width with the projected wall so it remains visible nearby
    // without swallowing distant floor and ceiling pixels.
    float radius = clamp(projectedWallHeight * 0.08, 2.0, 8.0);
    float edge = smoothRamp(pixelDistance / radius);
    return mix(0.86, 1.0, edge);
}

float weaponIllumination()
{
    // The weapon starts darker than its original palette values. Downward
    // brightness raises it toward full brightness beneath ceiling light cones.
    // A firing frame containing a visible muzzle flash is emissive rather than
    // allowing room ambience to dull the flame.
    float illumination = 0.60 * playerAmbientScale;
    for (int index = 0; index < 32; index++)
    {
        float4 light = sceneLights[index];
        float distance = length(playerPosition - light.xy);
        float conePosition = clamp(distance / 1.5, 0.0, 1.0);
        float cone = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
        illumination += light.w * cone * 0.80;
    }
    return mix(clamp(illumination, 0.20, 1.0), 1.0, clamp(weaponFlash, 0.0, 1.0));
}

float3 muzzleIllumination(float2 worldPosition)
{
    const float radius = 2.50;
    float2 flashPosition = playerPosition + (cameraDirection * 0.35);
    float distance = length(worldPosition - flashPosition);
    float conePosition = clamp(distance / radius, 0.0, 1.0);
    float falloff = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
    return float3(1.0, 0.85, 0.69) * muzzleFlash * falloff * 0.90;
}

float3 surfaceIllumination(float2 worldPosition, float upward)
{
    float3 illumination = float3(0.0);
    for (int index = 0; index < 32; index++)
    {
        float4 light = sceneLights[index];
        float brightness = mix(light.w, light.z, upward);
        float3 lightColor = mix(sceneLightDownColors[index].rgb, sceneLightUpColors[index].rgb, upward);
        float2 radii = sceneLightRadii[index];
        float radius = max(mix(radii.y, radii.x, upward), 0.0001);
        float distance = length(worldPosition - light.xy);
        float conePosition = clamp(distance / radius, 0.0, 1.0);
        float cone = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
        illumination += lightColor * brightness * cone * 0.65;
    }
    return illumination;
}

float3 wallSurfaceNormal(
    float textureX,
    float textureV,
    float texturePage,
    float orientation,
    float2 rayDirection,
    float bumpStrength)
{
    const float textureSize = 64.0;
    float localY = floor(textureV * textureSize) + 0.5;
    float atlasY = (texturePage * textureSize) + localY;
    float leftHeight = sample(wallHeightAtlas, float2(max(textureX - 1.0, 0.5), atlasY)).r;
    float rightHeight = sample(wallHeightAtlas, float2(min(textureX + 1.0, 63.5), atlasY)).r;
    float upperHeight = sample(
        wallHeightAtlas,
        float2(textureX, (texturePage * textureSize) + max(localY - 1.0, 0.5))).r;
    float lowerHeight = sample(
        wallHeightAtlas,
        float2(textureX, (texturePage * textureSize) + min(localY + 1.0, 63.5))).r;
    float horizontalSlope = (rightHeight - leftHeight) * bumpStrength * 2.15;
    float verticalSlope = (lowerHeight - upperHeight) * bumpStrength * 2.15;

    float3 geometricNormal;
    float3 horizontalTangent;
    if (orientation < 0.5)
    {
        geometricNormal = float3(-sign(rayDirection.x), 0.0, 0.0);
        horizontalTangent = float3(0.0, sign(rayDirection.x), 0.0);
    }
    else
    {
        geometricNormal = float3(0.0, -sign(rayDirection.y), 0.0);
        horizontalTangent = float3(-sign(rayDirection.y), 0.0, 0.0);
    }
    // Texture V increases downward while world Z increases upward.
    float3 verticalTangent = float3(0.0, 0.0, -1.0);
    return normalize(
        geometricNormal -
        (horizontalTangent * horizontalSlope) -
        (verticalTangent * verticalSlope));
}

float3 wallLocalIllumination(
    float2 worldPosition,
    float wallHeight,
    float3 normal,
    float3 albedo,
    float specularStrength,
    float gloss)
{
    float3 viewDirection = normalize(float3(playerPosition - worldPosition, 0.5 - wallHeight));
    // The pixel artwork represents fairly coarse surfaces, so broad highlights
    // read better than physically sharp points at Wolfenstein's native resolution.
    float exponent = mix(3.0, 26.0, gloss);
    float3 contribution = float3(0.0);
    for (int index = 0; index < 32; index++)
    {
        float4 light = sceneLights[index];
        float sourceHeight = sceneLightHeights[index];
        float upward = wallHeight >= sourceHeight ? 1.0 : 0.0;
        float brightness = mix(light.w, light.z, upward);
        float3 lightColor = mix(sceneLightDownColors[index].rgb, sceneLightUpColors[index].rgb, upward);
        float2 radii = sceneLightRadii[index];
        float radius = max(mix(radii.y, radii.x, upward), 0.0001);
        float horizontalDistance = length(worldPosition - light.xy);
        float conePosition = clamp(horizontalDistance / radius, 0.0, 1.0);
        float cone = 1.0 - (conePosition * conePosition * (3.0 - 2.0 * conePosition));
        float3 lightDirection = normalize(float3(light.xy - worldPosition, sourceHeight - wallHeight));
        float facing = max(dot(normal, lightDirection), 0.0);
        float diffuse = mix(0.22, 1.0, facing);
        float3 halfDirection = normalize(lightDirection + viewDirection);
        float highlight = pow(max(dot(normal, halfDirection), 0.0), exponent) *
                          mix(0.30, 1.0, facing);
        contribution += (albedo * lightColor * brightness * cone * diffuse * 0.44) +
                        (lightColor * brightness * cone * highlight * specularStrength * 2.55);
    }

    const float muzzleRadius = 2.5;
    float3 muzzlePosition = float3(playerPosition + (cameraDirection * 0.35), 0.55);
    float3 surfacePosition = float3(worldPosition, wallHeight);
    float3 muzzleDelta = muzzlePosition - surfacePosition;
    float muzzleDistance = length(muzzleDelta);
    float muzzlePositionInRadius = clamp(muzzleDistance / muzzleRadius, 0.0, 1.0);
    float muzzleFalloff = 1.0 -
                          (muzzlePositionInRadius * muzzlePositionInRadius *
                           (3.0 - (2.0 * muzzlePositionInRadius)));
    float3 muzzleDirection = normalize(muzzleDelta);
    float muzzleFacing = max(dot(normal, muzzleDirection), 0.0);
    float3 muzzleHalfDirection = normalize(muzzleDirection + viewDirection);
    float muzzleHighlight = pow(max(dot(normal, muzzleHalfDirection), 0.0), exponent) * muzzleFacing;
    contribution += float3(1.0, 0.85, 0.69) * muzzleFlash * muzzleFalloff *
                    muzzleHighlight * specularStrength * 1.80;
    return contribution;
}

float wallAmbientRelief(float3 normal, float orientation, float2 rayDirection)
{
    float3 geometricNormal = orientation < 0.5
        ? float3(-sign(rayDirection.x), 0.0, 0.0)
        : float3(0.0, -sign(rayDirection.y), 0.0);
    // A soft overhead/world-space fill makes generated relief readable outside
    // direct light cones without pretending every wall has a glossy headlamp.
    float3 fillDirection = normalize(geometricNormal + float3(0.24, -0.18, 0.58));
    float flatResponse = dot(geometricNormal, fillDirection);
    float bumpedResponse = dot(normal, fillDirection);
    return clamp(1.0 + ((bumpedResponse - flatResponse) * 1.15), 0.78, 1.20);
}

float3 doorwaySpillIllumination(float2 worldPosition)
{
    const float spillLength = 4.0;
    float illumination = 0.0;
    for (int index = 0; index < 32; index++)
    {
        float4 spill = doorwaySpills[index];
        float strength = length(spill.zw);
        if (strength <= 0.0001)
            continue;
        float2 direction = spill.zw / strength;
        float2 relative = worldPosition - spill.xy;
        float forward = dot(relative, direction);
        if (forward < -0.15 || forward > spillLength)
            continue;
        float lateral = abs((relative.x * direction.y) - (relative.y * direction.x));
        float halfWidth = 0.52 + (max(forward, 0.0) * 0.22);
        if (lateral >= halfWidth)
            continue;
        float thresholdFade = smoothRamp((forward + 0.15) / 0.45);
        float lengthFade = 1.0 - smoothRamp(max(forward, 0.0) / spillLength);
        float edgeFade = 1.0 - smoothRamp(lateral / halfWidth);
        illumination += strength * thresholdFade * lengthFade * edgeFade * 0.55;
    }
    return float3(1.0, 0.95, 0.84) * illumination;
}

float4 main(float2 fragment)
{
    const float nativeWidth = 320.0;
    const float nativeHeight = 200.0;
    const float nativePlayHeight = 160.0;
    const float textureSize = 64.0;

    // Convert Avalonia's 4:3 presentation coordinates back to native Mode 13h
    // coordinates. Horizontal and vertical scale are kept separate for resizing.
    float2 displayScale = outputResolution / float2(nativeWidth, nativeHeight);
    float2 nativePosition = fragment / displayScale;
    bool isPlayView = nativePosition.y < nativePlayHeight;

    // View bob moves the 3D scene and its sprites, but never the fixed HUD.
    float2 scenePosition = nativePosition;
    if (isPlayView)
        scenePosition.y = clamp(scenePosition.y - viewBob, 0.5, nativePlayHeight - 0.5);

    int columnIndex = clamp(int(scenePosition.x), 0, 319);
    float cameraX = (2.0 * (scenePosition.x + 0.5) / nativeWidth) - 1.0;
    float2 rayDirection = cameraDirection + (cameraPlane * cameraX);
    float4 column = wallColumns[columnIndex];
    float distance = max(column.x, 0.0001);
    float projectedHeight = nativeHeight / distance;
    float wallTop = (nativePlayHeight - projectedHeight) * 0.5;
    float sceneDistance = distance;

    float4 color;
    if (!isPlayView)
    {
        color = floorColor;
    }
    else if (scenePosition.y < wallTop)
    {
        color = ceilingColor;
        // Intersect the view ray with the unit-height ceiling plane. The camera
        // is halfway between floor and ceiling, giving a 100-pixel projection height.
        float ceilingDistance = 100.0 / max(80.0 - scenePosition.y, 0.5);
        sceneDistance = ceilingDistance;
        float2 ceilingPosition = playerPosition + (rayDirection * ceilingDistance);
        float3 illumination = float3(ambientIllumination(ceilingDistance, ceilingPosition));
        illumination += surfaceIllumination(ceilingPosition, 1.0);
        illumination += muzzleIllumination(ceilingPosition);
        color.rgb *= min(illumination, 1.0);
        color.rgb *= surfaceContactAmbientOcclusion(wallTop - scenePosition.y, projectedHeight);
    }
    else if (scenePosition.y >= wallTop + projectedHeight)
    {
        color = floorColor;
        float floorDistance = 100.0 / max(scenePosition.y - 80.0, 0.5);
        sceneDistance = floorDistance;
        float2 floorPosition = playerPosition + (rayDirection * floorDistance);
        float3 illumination = float3(ambientIllumination(floorDistance, floorPosition));
        illumination += surfaceIllumination(floorPosition, 0.0);
        illumination += muzzleIllumination(floorPosition);
        illumination += doorwaySpillIllumination(floorPosition);
        color.rgb *= min(illumination, 1.0);
        color.rgb *= surfaceContactAmbientOcclusion(
            scenePosition.y - (wallTop + projectedHeight),
            projectedHeight);
    }
    else
    {
        // Project the native screen row back onto the 64-pixel wall texture.
        float textureV = clamp((scenePosition.y - wallTop) / projectedHeight, 0.0, 0.999999);
        float textureX = floor(clamp(column.y, 0.0, 0.999999) * textureSize) + 0.5;
        float texturePage = floor(column.z + 0.5);
        float textureY = (texturePage * textureSize) + floor(textureV * textureSize) + 0.5;
        color = sample(wallTextureAtlas, float2(textureX, textureY));
        float3 wallAlbedo = color.rgb;
        float3 material = sample(wallMaterialMap, float2(texturePage + 0.5, 0.5)).rgb;

        // Distance is perpendicular to the camera plane, so this darkening does
        // not bow across the screen and can later be combined with real lights.
        // Bias toward the visible side of the wall so its ambience comes from
        // the room being viewed rather than the solid wall tile itself.
        float2 wallPosition = playerPosition + (rayDirection * distance);
        float orientation = column.w - (floor(column.w / 2.0) * 2.0);
        float wallHeight = 1.0 - textureV;
        float3 wallNormal = wallSurfaceNormal(
            textureX,
            textureV,
            texturePage,
            orientation,
            rayDirection,
            material.r);
        float isDoor = floor(column.w / 8.0) - (floor(column.w / 16.0) * 2.0);
        float2 ambientPosition = wallPosition - (rayDirection * 0.01);
        if (isDoor > 0.5)
        {
            // A door occupies the centre of its map tile rather than its edge.
            // Sample just across its centre plane on the viewer-facing side so
            // a closed panel cannot borrow ambience from the room behind it.
            if (orientation < 0.5)
                ambientPosition.x = wallPosition.x - (sign(rayDirection.x) * 0.51);
            else
                ambientPosition.y = wallPosition.y - (sign(rayDirection.y) * 0.51);
        }
        float3 illumination = float3(ambientIllumination(distance, ambientPosition));
        illumination *= mix(1.0, 0.92, orientation);
        // Vertical walls receive a restrained blend of the upward and downward
        // components. This lets local sources such as treasure softly illuminate
        // nearby walls without overpowering their directional floor/ceiling light.
        illumination += muzzleIllumination(wallPosition);
        color.rgb *= min(illumination, 1.0);
        color.rgb *= wallAmbientRelief(wallNormal, orientation, rayDirection);
        color.rgb = min(color.rgb + wallLocalIllumination(
                wallPosition,
                wallHeight,
                wallNormal,
                wallAlbedo,
                material.g,
                material.b), float3(1.0));
        color.rgb *= wallAmbientOcclusion(column.y, textureV, column.w);
    }

    if (isPlayView)
        color.rgb = mix(color.rgb, fogColor.rgb, distanceFogAmount(sceneDistance));

    // Bloom sits behind the sharp original sprite so its pixel artwork remains intact.
    float3 bloom = sample(softwareBloomOverlay, scenePosition).rgb;
    color.rgb = min(color.rgb + bloom, float3(1.0));

    // World sprites follow view bob; the HUD remains fixed.
    float4 overlay = sample(softwareSpriteOverlay, isPlayView ? scenePosition : nativePosition);
    color = float4(mix(color.rgb, overlay.rgb, overlay.a), 1.0);

    // Composite the separately rendered weapon after world sprites, matching the
    // software draw order while allowing only the weapon to react to overhead light.
    float2 weaponPosition = scenePosition - float2(weaponSway, 0.0);
    float4 weapon = sample(softwareWeaponOverlay, weaponPosition);
    weapon.rgb *= weaponIllumination();
    color = float4(mix(color.rgb, weapon.rgb, weapon.a), 1.0);

    // Preserve the original full-frame feedback ordering after scene composition.
    if (isPlayView && randomHash(nativePosition) < deathFade)
        color = deathColor;
    color.rgb = mix(color.rgb, float3(1.0, 0.0, 0.0), clamp(damageFlash, 0.0, 1.0));
    color.rgb *= 1.0 - clamp(levelFade, 0.0, 1.0);
    return float4(color.rgb, 1.0);
}
