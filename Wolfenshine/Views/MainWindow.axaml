<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Wolfenshine.Views"
        xmlns:vm="using:Wolfenshine.ViewModels"
        x:Class="Wolfenshine.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="640"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="*,Auto" Background="#111318">
    <Border Grid.Row="0" Margin="24" Background="#08090B" BorderBrush="#343942" BorderThickness="1">
      <Viewbox Stretch="Uniform">
        <Border Width="{Binding NativeViewportWidth}"
                Height="{Binding NativeViewportHeight}"
                Background="#20242B">
          <Grid>
            <local:SoftwareViewport IsVisible="{Binding HasGameData}"
                                    Map="{Binding SelectedMap}"
                                    Camera="{Binding Camera}"
                                    RenderOptions.BitmapInterpolationMode="LowQuality" />

            <StackPanel IsVisible="{Binding !HasGameData}"
                        Width="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
              <TextBlock Text="GAME DATA NOT FOUND"
                         HorizontalAlignment="Center"
                         FontSize="12"
                         FontWeight="Bold"
                         Foreground="#F07D7D" />
              <TextBlock Text="{Binding DataErrorMessage}"
                         FontSize="6"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="#D7D9DC" />
            </StackPanel>
          </Grid>
        </Border>
      </Viewbox>
    </Border>

    <Border Grid.Row="1" Background="#1A1E24" BorderBrush="#343942" BorderThickness="0,1,0,0" Padding="12,7">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#AEB4BC" />
    </Border>
  </Grid>
</Window>
