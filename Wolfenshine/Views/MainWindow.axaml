<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Wolfenshine.Views"
        xmlns:vm="using:Wolfenshine.ViewModels"
        x:Class="Wolfenshine.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="640"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="*,Auto" Background="#111318">
    <Border Grid.Row="0" Margin="24" Background="#08090B" BorderBrush="#343942" BorderThickness="1">
      <Viewbox Stretch="Uniform">
        <Border x:Name="GameViewport"
                Width="{Binding PresentationViewportWidth}"
                Height="{Binding PresentationViewportHeight}"
                Background="#20242B">
          <Grid>
            <local:SoftwareViewport x:Name="SoftwareViewport"
                                    IsVisible="{Binding IsAuthenticRendering}"
                                    Map="{Binding SelectedMap}"
                                    Doors="{Binding Doors}"
                                    PushWalls="{Binding PushWalls}"
                                    ElevatorSwitch="{Binding ElevatorSwitch}"
                                    Camera="{Binding Camera}"
                                    WallTextures="{Binding WallTextures}"
                                    Palette="{Binding Palette}"
                                    WeaponSprite="{Binding WeaponSprite}"
                                    Sprites="{Binding Sprites}"
                                    StaticObjects="{Binding WorldObjects}"
                                    StatusBar="{Binding StatusBar}"
                                    DamageFlash="{Binding DamageFlash}"
                                    DeathFade="{Binding DeathFade}"
                                    LevelFade="{Binding LevelFade}"
                                    RenderOptions.BitmapInterpolationMode="LowQuality" />

            <local:EnhancedViewport x:Name="EnhancedViewport"
                                    IsVisible="{Binding IsEnhancedRendering}"
                                    Map="{Binding SelectedMap}"
                                    Doors="{Binding Doors}"
                                    PushWalls="{Binding PushWalls}"
                                    ElevatorSwitch="{Binding ElevatorSwitch}"
                                    Camera="{Binding Camera}"
                                    WallTextures="{Binding WallTextures}"
                                    Palette="{Binding Palette}"
                                    WeaponSprite="{Binding WeaponSprite}"
                                    Sprites="{Binding Sprites}"
                                    StaticObjects="{Binding WorldObjects}"
                                    LightObjects="{Binding AccessibleLightObjects}"
                                    EnvironmentalEffectObjects="{Binding AccessibleEnvironmentalEffects}"
                                    DynamicLights="{Binding EnemyMuzzleFlashes}"
                                    HasGoldKey="{Binding HasGoldKey}"
                                    HasSilverKey="{Binding HasSilverKey}"
                                    StatusBar="{Binding StatusBar}"
                                    DamageFlash="{Binding DamageFlash}"
                                    DamageTrauma="{Binding DamageTrauma}"
                                    DamageDirection="{Binding DamageDirection}"
                                    DamageSeed="{Binding DamageRevision}"
                                    DamageTint="{Binding DamageTint}"
                                    BloodAmount="{Binding BloodAmount}"
                                    MuzzleFlash="{Binding MuzzleFlash}"
                                    IsWeaponFlashFrame="{Binding IsWeaponFlashFrame}"
                                    DeathFade="{Binding DeathFade}"
                                    LevelFade="{Binding LevelFade}" />

            <local:IntermissionViewport IsVisible="{Binding IsShowingLevelStats}"
                                        Width="320"
                                        Height="192"
                                        VerticalAlignment="Top"
                                        Stats="{Binding LevelStats}"
                                        Graphics="{Binding IntermissionGraphics}"
                                        Palette="{Binding Palette}"
                                        BjFrame="{Binding BjFrame}"
                                        RenderOptions.BitmapInterpolationMode="LowQuality" />

            <local:DifficultyViewport IsVisible="{Binding IsSelectingDifficulty}"
                                      Graphics="{Binding DifficultyGraphics}"
                                      Palette="{Binding Palette}"
                                      Selection="{Binding SelectedDifficultyIndex}"
                                      RenderOptions.BitmapInterpolationMode="LowQuality" />

            <local:PauseViewport IsVisible="{Binding IsPaused}"
                                 Graphic="{Binding PauseGraphic}"
                                 Palette="{Binding Palette}"
                                 RenderOptions.BitmapInterpolationMode="LowQuality" />

            <Border IsVisible="{Binding ShowFramesPerSecond}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,3,4,0"
                    Padding="2,1"
                    CornerRadius="1"
                    Background="#A0000000">
              <TextBlock Text="{Binding FramesPerSecondText}"
                         FontSize="6"
                         FontWeight="SemiBold"
                         Foreground="#FFFFFF" />
            </Border>

            <StackPanel IsVisible="{Binding !HasGameData}"
                        Width="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
              <TextBlock Text="GAME DATA NOT FOUND"
                         HorizontalAlignment="Center"
                         FontSize="12"
                         FontWeight="Bold"
                         Foreground="#F07D7D" />
              <TextBlock Text="{Binding DataErrorMessage}"
                         FontSize="6"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="#D7D9DC" />
            </StackPanel>
          </Grid>
        </Border>
      </Viewbox>
    </Border>

    <Border Grid.Row="1" Background="#1A1E24" BorderBrush="#343942" BorderThickness="0,1,0,0" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#AEB4BC" />
        <TextBlock Grid.Column="1"
                   Margin="16,0,0,0"
                   Text="{Binding RenderModeText}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#7FC9A5" />
      </Grid>
    </Border>
  </Grid>
</Window>
